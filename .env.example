# Free Google Gemini LLM Provider Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Vector Database Configuration (Qdrant)
# For local embedded Qdrant (zero-setup), leave QDRANT_URL empty
QDRANT_URL=
QDRANT_API_KEY=

# Search Tool Configuration (Tavily)
TAVILY_API_KEY=your_tavily_api_key_here

# MongoDB Persistent Storage Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=adaptive_rag

# Application Settings
LOG_LEVEL=INFO
MODEL_NAME=gemini-flash-latest
