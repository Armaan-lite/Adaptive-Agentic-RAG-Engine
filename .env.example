# Groq Cloud LLM Provider Configuration (100% Free - 300 RPM)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Local HuggingFace Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector Database Configuration (Qdrant)
# For local embedded Qdrant (zero-setup), leave QDRANT_URL empty
QDRANT_URL=
QDRANT_API_KEY=

# Search Tool Configuration (Tavily)
TAVILY_API_KEY=your_tavily_api_key_here

# MongoDB Persistent Storage Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=adaptive_rag

# Application Settings
LOG_LEVEL=INFO
MODEL_NAME=llama-3.3-70b-versatile

# LangSmith LLM Observability & Tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=adaptive-rag-engine

